# Copy to .env.e2e.local (gitignored) when an isolated Supabase E2E project exists.
# Never commit real keys. Never point these at production.

# App under test must use the E2E project (same URL as E2E_SUPABASE_URL).
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_E2E_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Explicit protect URL = your real/dev project that must never be seeded.
E2E_PROTECT_SUPABASE_URL=https://YOUR_DEV_OR_PROD_PROJECT.supabase.co

# Isolation markers (must match NEXT_PUBLIC_SUPABASE_* above).
E2E_BASE_URL=http://localhost:3000
E2E_SUPABASE_URL=https://YOUR_E2E_PROJECT.supabase.co
E2E_SUPABASE_ANON_KEY=
E2E_SUPABASE_SERVICE_ROLE_KEY=

# Unique run prefix for synthetic fixtures (required).
E2E_PREFIX=E2E-WOLOYEM-0000000000000

# Brevo — app transactional email_jobs (invites, billing notices). Never commit real keys.
# Separate from Supabase Auth SMTP (dashboard staging only — see docs/saas/brevo-staging-setup.md).
# BREVO_API_KEY=   # API key (SMTP & API → API keys), NOT the SMTP key
# BREVO_SENDER_EMAIL=noreply@your-verified-domain
# BREVO_SENDER_NAME=WOLOYEM Score
# CRON_SECRET=     # required to flush email_jobs via POST /api/cron/maintenance

# Optional AI for assistant conversation tests (never required for billing UI checks).
# AI_API_KEY=
# AI_PROVIDER=
# AI_MODEL=

# Database password for staging ONLY (Dashboard → Project Settings → Database).
# Required to apply SQL migrations via scripts/saas-staging-apply-migrations.mjs.
# Never use the ScorApp-XP / protect database password here.
# SUPABASE_DB_PASSWORD=
# DATABASE_URL=postgresql://postgres.[REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres

# Stripe must be absent or sk_test_ only. sk_live_ blocks all E2E guards.
# Required for Checkout / Portal / webhook E2E (never sk_live_ / pk_live_).
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_PRICE_STARTER_MONTHLY=price_...
# STRIPE_PRICE_PRO_MONTHLY=price_...
# STRIPE_PRICE_BUSINESS_MONTHLY=price_...
